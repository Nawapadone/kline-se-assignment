# Serve data from src/api/mock instead of a backend. Defaults to true, because
# this project ships no backend; set to "false" to point at a real one.
VITE_USE_MOCK=true

# Origin the real client prefixes onto the api-specs.md paths. Ignored in mock mode.
VITE_API_BASE_URL=http://localhost:8080

# PIN the mock client accepts. api-specs.md defines no auth endpoint.
VITE_DEMO_PIN=123456

# UI language baked into the build: "en" (default) or "th". Anything else means en.
VITE_LOCALE=en
